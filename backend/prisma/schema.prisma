  mergedInto    Bill?            @relation("BillMergeHistory", fields: [mergedIntoBillId], references: [id], onDelete: Restrict)
  mergedSources Bill[]           @relation("BillMergeHistory")
  issuedBy      User?            @relation("BillIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  voidedBy      User?            @relation("BillVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  mergedBy      User?            @relation("BillMergedBy", fields: [mergedById], references: [id], onDelete: Restrict)
  items         BillItem[]
  adjustments   BillAdjustment[]
  payments      Payment[]

  @@unique([branchId, billNumber])
  @@index([tableSessionId, status])
  @@index([mergedIntoBillId])
  @@index([branchId, status, createdAt])
  @@map("bills")
}

model BillItem {
  id                String   @id @default(uuid()) @db.Uuid
  billId            String   @map("bill_id") @db.Uuid
  orderItemId       String   @map("order_item_id") @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal  @map("unit_price_snapshot") @db.Decimal(14, 2)
  lineAmount        Decimal  @map("line_amount") @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bill      Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([billId, orderItemId])
  @@index([orderItemId])
  @@map("bill_items")
}

model BillAdjustment {
  id             String               @id @default(uuid()) @db.Uuid
  billId         String               @map("bill_id") @db.Uuid
  source         BillAdjustmentSource
  discountType   DiscountType         @map("discount_type")
  discountValue  Decimal              @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal              @map("discount_amount") @db.Decimal(14, 2)
  voucherId      String?              @map("voucher_id") @db.Uuid
  codeSnapshot   String?              @map("code_snapshot") @db.VarChar(48)
  status         BillAdjustmentStatus @default(ACTIVE)
  appliedById    String               @map("applied_by_id") @db.Uuid
  reversedById   String?              @map("reversed_by_id") @db.Uuid
  reversedAt     DateTime?            @map("reversed_at") @db.Timestamptz(3)
  reverseReason  String?              @map("reverse_reason") @db.Text
  isOverride     Boolean              @default(false) @map("is_override")
  overrideById   String?              @map("override_by_id") @db.Uuid
  overrideReason String?              @map("override_reason") @db.Text
  overrideBefore Json?                @map("override_before")
  overrideAfter  Json?                @map("override_after")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Restrict)
  voucher    Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  appliedBy  User     @relation("BillAdjustmentAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  reversedBy User?    @relation("BillAdjustmentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  overrideBy User?    @relation("BillAdjustmentOverrideBy", fields: [overrideById], references: [id], onDelete: Restrict)

  @@index([billId, status])
  @@index([voucherId, status])
  @@index([overrideById])
  @@map("bill_adjustments")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  billId         String        @map("bill_id") @db.Uuid
  method         PaymentMethod
  provider       String?       @db.VarChar(48)
  providerRef    String?       @map("provider_ref") @db.VarChar(160)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("VND") @db.Char(3)
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(128)
  initiatedById  String        @map("initiated_by_id") @db.Uuid
  confirmedById  String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(3)
  failureReason  String?       @map("failure_reason") @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Restrict)
  initiatedBy User   @relation("PaymentInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  confirmedBy User?  @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([billId, status])
  @@index([branchId, status, createdAt])
  @@map("payments")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  branchId   String?     @map("branch_id") @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(80)
  entityId   String      @map("entity_id") @db.Uuid
  beforeData Json?       @map("before_data")
  afterData  Json?       @map("after_data")
  metadata   Json?
  requestId  String?     @map("request_id") @db.VarChar(128)
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([branchId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RealtimeOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(96)
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([processedAt, availableAt])
  @@index([branchId, eventType, createdAt])
  @@map("realtime_outbox")
}
