generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE
  REJECTED

  @@map("account_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum SetupStatus {
  PENDING
  COMPLETED

  @@map("setup_status")
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
  PACKAGE

  @@map("unit_dimension")
}

enum TableStatus {
  ACTIVE
  INACTIVE
  OUT_OF_SERVICE

  @@map("table_status")
}

enum QrStatus {
  ACTIVE
  DISABLED

  @@map("qr_status")
}

enum SessionStatus {
  ACTIVE
  PAYMENT_REQUESTED
  LOCKED
  CLOSED

  @@map("session_status")
}

enum CartStatus {
  ACTIVE
  ORDERED
  ABANDONED
  EXPIRED

  @@map("cart_status")
}

enum ProcessingArea {
  BAR
  KITCHEN

  @@map("processing_area")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum OptionGroupType {
  SIZE
  TOPPING
  SUGAR
  ICE
  CUSTOM

  @@map("option_group_type")
}

enum RecipeType {
  BASE
  SIZE
  ADD_ON

  @@map("recipe_type")
}

enum IngredientStatus {
  ACTIVE
  INACTIVE

  @@map("ingredient_status")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum InventoryTransactionType {
  IMPORT
  ORDER_CONSUMPTION
  WASTE
  DAMAGED
  STAFF_USE
  ADJUSTMENT
  STOCKTAKE
  RETURN

  @@map("inventory_transaction_type")
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  COMPLETED
  CANCELLED

  @@map("stocktake_status")
}

enum OrderSource {
  CUSTOMER
  STAFF

  @@map("order_source")
}

enum OrderItemStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("order_item_status")
}

enum ServiceRequestType {
  CALL_STAFF
  REQUEST_PAYMENT

  @@map("service_request_type")
}

enum ServiceRequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  CANCELLED

  @@map("service_request_status")
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT

  @@map("discount_type")
}

enum VoucherStatus {
  ACTIVE
  INACTIVE

  @@map("voucher_status")
}

enum BillStatus {
  DRAFT
  ISSUED
  PAID
  MERGED
  VOID

  @@map("bill_status")
}

enum BillAdjustmentSource {
  VOUCHER
  DIRECT_DISCOUNT

  @@map("bill_adjustment_source")
}

enum BillAdjustmentStatus {
  ACTIVE
  REVERSED

  @@map("bill_adjustment_status")
}

enum PaymentMethod {
  CASH
  QR_MOCK
  BANK_QR
  VNPAY
  MOMO
  ZALOPAY
  BANK_TRANSFER

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED

  @@map("payment_status")
}

enum AttendanceStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  CANCELLED

  @@map("attendance_status")
}

enum AttendanceEventSource {
  NORMAL_LOGIN
  NORMAL_LOGOUT
  SYSTEM_AUTO
  MANUAL_ADJUSTMENT

  @@map("attendance_event_source")
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED

  @@map("idempotency_status")
}

enum AuditAction {
  FIRST_TIME_SETUP_COMPLETED
  CANCEL_ORDER
  CANCEL_ORDER_ITEM
  TRANSFER_TABLE
  SPLIT_BILL
  MERGE_BILL
  VOID_BILL
  APPLY_VOUCHER
  APPLY_DISCOUNT
  DISCOUNT_OVERRIDE
  CONFIRM_PAYMENT
  IMPORT_INVENTORY
  EXPORT_INVENTORY
  ADJUST_INVENTORY
  STOCKTAKE
  UPDATE_RECIPE
  APPROVE_USER
  REJECT_USER
  UPDATE_ROLE
  LOCK_USER
  UNLOCK_USER
  UPDATE_SHIFT
  UPDATE_ATTENDANCE
  AUTO_CHECK_OUT
  ROTATE_QR
  DISABLE_QR
  CLOSE_SESSION

  @@map("audit_action")
}

model SystemSetup {
  id              Int         @id @default(1) @db.SmallInt
  status          SetupStatus @default(PENDING)
  setupTokenHash  String?     @map("setup_token_hash") @db.VarChar(255)
  tokenExpiresAt  DateTime?   @map("token_expires_at") @db.Timestamptz(3)
  tokenConsumedAt DateTime?   @map("token_consumed_at") @db.Timestamptz(3)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(3)
  completedById   String?     @map("completed_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  completedBy User? @relation("SetupCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)

  @@map("system_setup")
}

model Unit {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(24)
  name      String        @db.VarChar(120)
  symbol    String        @db.VarChar(24)
  dimension UnitDimension
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  baseIngredients            Ingredient[]           @relation("IngredientBaseUnit")
  ingredientUnits            IngredientUnit[]
  conversionsFrom            UnitConversion[]       @relation("UnitConversionFrom")
  conversionsTo              UnitConversion[]       @relation("UnitConversionTo")
  inputInventoryTransactions InventoryTransaction[] @relation("InventoryTransactionInputUnit")

  @@index([dimension, isActive])
  @@map("units")
}

model IngredientUnit {
  id           String   @id @default(uuid()) @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  label        String?  @db.VarChar(80)
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([ingredientId, unitId])
  @@index([unitId, isActive])
  @@map("ingredient_units")
}

model UnitConversion {
  id               String   @id @default(uuid()) @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  fromUnitId       String   @map("from_unit_id") @db.Uuid
  toUnitId         String   @map("to_unit_id") @db.Uuid
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(18, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  fromUnit   Unit       @relation("UnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit     Unit       @relation("UnitConversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("UnitConversionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([ingredientId, fromUnitId, toUnitId])
  @@index([fromUnitId, toUnitId, isActive])
  @@map("unit_conversions")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  scope          String            @db.VarChar(96)
  key            String            @db.VarChar(128)
  requestHash    String            @map("request_hash") @db.VarChar(128)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  status         IdempotencyStatus @default(PROCESSING)
  lockedUntil    DateTime?         @map("locked_until") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([scope, key])
  @@index([branchId, scope, createdAt])
  @@index([status, expiresAt])
  @@map("idempotency_keys")
}

model Branch {
  id                     String       @id @default(uuid()) @db.Uuid
  code                   String       @unique @db.VarChar(32)
  name                   String       @db.VarChar(160)
  timezone               String       @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  attendanceGraceMinutes Int          @default(30) @map("attendance_grace_minutes")
  address                String?      @db.Text
  phone                  String?      @db.VarChar(32)
  logoPath               String?      @map("logo_path") @db.Text
  bannerPath             String?      @map("banner_path") @db.Text
  status                 BranchStatus @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamptz(3)

  staffBranches         StaffBranch[]
  shifts                Shift[]
  categories            Category[]
  products              Product[]
  optionGroups          OptionGroup[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  stocktakes            Stocktake[]
  diningTables          DiningTable[]
  tableSessions         TableSession[]
  carts                 Cart[]
  orders                Order[]
  serviceRequests       ServiceRequest[]
  vouchers              Voucher[]
  bills                 Bill[]
  payments              Payment[]
  auditLogs             AuditLog[]
  realtimeOutbox        RealtimeOutbox[]
  idempotencyKeys       IdempotencyKey[]

  @@map("branches")
}

model User {
  id          String        @id @default(uuid()) @db.Uuid
  authUserId  String        @unique @map("auth_user_id") @db.Uuid
  email       String        @unique @db.VarChar(320)
  displayName String        @map("display_name") @db.VarChar(160)
  avatarPath  String?       @map("avatar_path") @db.Text
  status      AccountStatus @default(PENDING)
  lastLoginAt DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  staffBranches           StaffBranch[]
  attendanceAdjustments   Attendance[]             @relation("AttendanceAdjustedBy")
  generatedQrCodes        TableQrCode[]            @relation("QrGeneratedBy")
  openedSessions          TableSession[]           @relation("SessionOpenedBy")
  lockedSessions          TableSession[]           @relation("SessionLockedBy")
  closedSessions          TableSession[]           @relation("SessionClosedBy")
  createdOrders           Order[]                  @relation("OrderCreatedBy")
  cancelledOrders         Order[]                  @relation("OrderCancelledBy")
  cancelledOrderItems     OrderItem[]              @relation("OrderItemCancelledBy")
  orderItemStatusChanges  OrderItemStatusHistory[] @relation("OrderItemStatusChangedBy")
  inventoryTransactions   InventoryTransaction[]   @relation("InventoryTransactionCreatedBy")
  unitConversionsCreated  UnitConversion[]         @relation("UnitConversionCreatedBy")
  stocktakesStarted       Stocktake[]              @relation("StocktakeStartedBy")
  stocktakesCompleted     Stocktake[]              @relation("StocktakeCompletedBy")
  handledServiceRequests  ServiceRequest[]         @relation("ServiceRequestHandledBy")
  issuedBills             Bill[]                   @relation("BillIssuedBy")
  voidedBills             Bill[]                   @relation("BillVoidedBy")
  mergedBills             Bill[]                   @relation("BillMergedBy")
  appliedBillAdjustments  BillAdjustment[]         @relation("BillAdjustmentAppliedBy")
  reversedBillAdjustments BillAdjustment[]         @relation("BillAdjustmentReversedBy")
  overrideBillAdjustments BillAdjustment[]         @relation("BillAdjustmentOverrideBy")
  initiatedPayments       Payment[]                @relation("PaymentInitiatedBy")
  confirmedPayments       Payment[]                @relation("PaymentConfirmedBy")
  auditLogs               AuditLog[]               @relation("AuditActor")
  completedSetups         SystemSetup[]            @relation("SetupCompletedBy")

  @@index([status])
  @@map("users")
}

model StaffBranch {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  employeeCode String?  @map("employee_code") @db.VarChar(32)
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roleAssignments  StaffRole[]
  shiftAssignments ShiftAssignment[]

  @@unique([userId, branchId])
  @@unique([branchId, employeeCode])
  @@index([branchId, isActive])
  @@map("staff_branches")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffAssignments StaffRole[]
  permissions      RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(96)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model StaffRole {
  id            String   @id @default(uuid()) @db.Uuid
  staffBranchId String   @map("staff_branch_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  assignedAt    DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  staffBranch StaffBranch @relation(fields: [staffBranchId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([staffBranchId, roleId])
  @@index([roleId])
  @@map("staff_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Shift {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  code         String   @db.VarChar(32)
  name         String   @db.VarChar(120)
  startTime    DateTime @map("start_time") @db.Time(0)
  endTime      DateTime @map("end_time") @db.Time(0)
  graceMinutes Int?     @map("grace_minutes")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]

  @@unique([branchId, code])
  @@index([branchId, isActive])
  @@map("shifts")
}

model ShiftAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  staffBranchId String   @map("staff_branch_id") @db.Uuid
  shiftId       String   @map("shift_id") @db.Uuid
  workDate      DateTime @map("work_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffBranch StaffBranch @relation(fields: [staffBranchId], references: [id], onDelete: Restrict)
  shift       Shift       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  attendance  Attendance?

  @@unique([staffBranchId, shiftId, workDate])
  @@index([workDate, shiftId])
  @@index([staffBranchId, workDate])
  @@map("shift_assignments")
}

model Attendance {
  id                String                 @id @default(uuid()) @db.Uuid
  shiftAssignmentId String                 @unique @map("shift_assignment_id") @db.Uuid
  status            AttendanceStatus       @default(SCHEDULED)
  checkInAt         DateTime?              @map("check_in_at") @db.Timestamptz(3)
  checkOutAt        DateTime?              @map("check_out_at") @db.Timestamptz(3)
  checkInSource     AttendanceEventSource? @map("check_in_source")
  checkOutSource    AttendanceEventSource? @map("check_out_source")
  adjustedById      String?                @map("adjusted_by_id") @db.Uuid
  adjustmentReason  String?                @map("adjustment_reason") @db.Text
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Restrict)
  adjustedBy      User?           @relation("AttendanceAdjustedBy", fields: [adjustedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("attendances")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(120)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([branchId, code])
  @@index([branchId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  categoryId     String         @map("category_id") @db.Uuid
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(160)
  description    String?        @db.Text
  imagePath      String?        @map("image_path") @db.Text
  basePrice      Decimal        @map("base_price") @db.Decimal(14, 2)
  processingArea ProcessingArea @map("processing_area")
  status         ProductStatus  @default(ACTIVE)
  isFeatured     Boolean        @default(false) @map("is_featured")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups ProductOptionGroup[]
  recipes      Recipe[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([branchId, code])
  @@index([branchId, categoryId, status])
  @@index([branchId, isFeatured, status])
  @@map("products")
}

model OptionGroup {
  id        String          @id @default(uuid()) @db.Uuid
  branchId  String          @map("branch_id") @db.Uuid
  code      String          @db.VarChar(32)
  name      String          @db.VarChar(120)
  type      OptionGroupType
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(3)

  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  values        OptionValue[]
  productGroups ProductOptionGroup[]

  @@unique([branchId, code])
  @@index([branchId, type, isActive])
  @@map("option_groups")
}

model OptionValue {
  id            String    @id @default(uuid()) @db.Uuid
  optionGroupId String    @map("option_group_id") @db.Uuid
  code          String    @db.VarChar(32)
  name          String    @db.VarChar(120)
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  optionGroup   OptionGroup          @relation(fields: [optionGroupId], references: [id], onDelete: Restrict)
  productValues ProductOptionValue[]

  @@unique([optionGroupId, code])
  @@index([optionGroupId, isActive, sortOrder])
  @@map("option_values")
}

model ProductOptionGroup {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  optionGroupId String   @map("option_group_id") @db.Uuid
  isRequired    Boolean  @default(false) @map("is_required")
  minSelections Int      @default(0) @map("min_selections")
  maxSelections Int      @default(1) @map("max_selections")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup          @relation(fields: [optionGroupId], references: [id], onDelete: Restrict)
  values      ProductOptionValue[]

  @@unique([productId, optionGroupId])
  @@index([productId, sortOrder])
  @@map("product_option_groups")
}

model ProductOptionValue {
  id                   String   @id @default(uuid()) @db.Uuid
  productOptionGroupId String   @map("product_option_group_id") @db.Uuid
  optionValueId        String   @map("option_value_id") @db.Uuid
  priceDelta           Decimal  @default(0) @map("price_delta") @db.Decimal(14, 2)
  isDefault            Boolean  @default(false) @map("is_default")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  productOptionGroup ProductOptionGroup @relation(fields: [productOptionGroupId], references: [id], onDelete: Cascade)
  optionValue        OptionValue        @relation(fields: [optionValueId], references: [id], onDelete: Restrict)
  recipes            Recipe[]
  cartItemOptions    CartItemOption[]
  orderItemOptions   OrderItemOption[]

  @@unique([productOptionGroupId, optionValueId])
  @@index([productOptionGroupId, isActive, sortOrder])
