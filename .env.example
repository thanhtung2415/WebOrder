# App
# SERVER ONLY unless explicitly mirrored by VITE_API_BASE_URL for browser use.
NODE_ENV=
APP_PORT=
BACKEND_URL=
FRONTEND_URL=

# Database
# SERVER ONLY. Do not expose database URLs to frontend/browser bundles.
DATABASE_URL=
DIRECT_URL=

# Supabase
# SUPABASE_URL and SUPABASE_ANON_KEY may be exposed to frontend only through VITE_* variables below.
# SUPABASE_SERVICE_ROLE_KEY is SERVER ONLY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PRODUCT_BUCKET=product-images

# Supabase Auth / JWT
# SERVER ONLY.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Google OAuth
# GOOGLE_CLIENT_SECRET is SERVER ONLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First-Time Setup
# SERVER ONLY. Leave blank in templates. Generate a strong random value per environment.
SETUP_TOKEN=

# Security
# QR_SESSION_SECRET is SERVER ONLY.
CORS_ORIGINS=
QR_SESSION_SECRET=
REQUEST_ID_HEADER=

# Reservation
RESERVATION_TTL_MINUTES=10

# Attendance
DEFAULT_ATTENDANCE_GRACE_MINUTES=30

# Realtime
REALTIME_ENABLED=true

# Logging
LOG_LEVEL=

# Frontend public variables
# Only these VITE_* variables are safe for browser bundles.
VITE_SUPABASE_URL=
# Preferred for new Supabase projects. VITE_SUPABASE_ANON_KEY remains supported for legacy JWT anon keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
